rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentAccess() {
      return get(/databases/$(database)/documents/accessUsers/$(request.auth.uid));
    }

    function approvedUser() {
      return signedIn()
        && currentAccess().data.approved == true
        && currentAccess().data.blocked != true
        && (
          currentAccess().data.role == "ADMIN" ||
          currentAccess().data.role == "PARTNER" ||
          currentAccess().data.role == "VIEWER"
        );
    }

    function admin() {
      return signedIn()
        && currentAccess().data.approved == true
        && currentAccess().data.blocked != true
        && currentAccess().data.role == "ADMIN";
    }

    function enterpriseAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/appConfig/admin)
        && get(/databases/$(database)/documents/appConfig/admin).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/appConfig/admin).data.role == "ADMIN";
    }

    function member(businessId) {
      return signedIn()
        && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.approved == true
        && get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.blocked == false;
    }

    function businessAdmin(businessId) {
      return member(businessId)
        && get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.role == "OWNER";
    }

    match /accessRequests/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if enterpriseAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "PENDING"
        && request.resource.data.startAt == 0
        && request.resource.data.expiresAt == 0
        && request.resource.data.notificationsEnabled == false;

      allow update: if enterpriseAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.status in ["PENDING", "ACTIVE", "BLOCKED", "REJECTED", "EXPIRED"]
        && request.resource.data.startAt is int
        && request.resource.data.expiresAt is int
        && request.resource.data.notificationsEnabled is bool;

      allow delete: if enterpriseAdmin();
    }

    match /accessUsers/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email_verified == true
        && (
          (request.resource.data.role == "PARTNER" &&
           request.resource.data.approved == false &&
           request.resource.data.email == request.auth.token.email)
          ||
          (request.resource.data.role == "ADMIN" &&
           request.resource.data.approved == true &&
           request.resource.data.email == request.auth.token.email &&
           (!exists(/databases/$(database)/documents/appConfig/admin) ||
            get(/databases/$(database)/documents/appConfig/admin).data.uid == request.auth.uid))
        );
      allow update, delete: if admin();
    }

    match /appConfig/admin {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && !exists(/databases/$(database)/documents/appConfig/admin)
        && request.resource.data.role == "ADMIN"
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if admin();
    }

    match /licenses/{licenseCode} {
      allow get: if signedIn();
      allow list: if admin();
      allow create, update, delete: if admin();
    }

    match /businesses/{businessId} {
      allow read: if member(businessId) || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if businessAdmin(businessId);

      match /members/{memberId} {
        allow read: if businessAdmin(businessId) || (member(businessId) && request.auth.uid == memberId);
        allow create: if businessAdmin(businessId)
          || (signedIn()
              && memberId == request.auth.uid
              && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid != ""
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.email == request.auth.token.email
              && request.resource.data.role == "PARTNER"
              && request.resource.data.approved == false
              && request.resource.data.blocked == false)
          || (signedIn()
              && memberId == request.auth.uid
              && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.email == request.auth.token.email
              && request.resource.data.role == "OWNER"
              && request.resource.data.approved == true
              && request.resource.data.blocked == false);
        allow update: if businessAdmin(businessId)
          && memberId != get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid
          && request.resource.data.uid == memberId
          && request.resource.data.role == "PARTNER"
          && request.resource.data.email == resource.data.email;
        allow delete: if businessAdmin(businessId)
          && memberId != get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid;
      }

      match /data/{document} {
        allow read: if member(businessId);
        allow write: if businessAdmin(businessId);
      }
    }

    match /users/{userId}/data/{document} {
      allow read: if approvedUser() && (request.auth.uid == userId || admin());
      allow write: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
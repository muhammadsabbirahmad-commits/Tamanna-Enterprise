rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentAccess() {
      return get(/databases/$(database)/documents/accessUsers/$(request.auth.uid));
    }

    function approvedUser() {
      return signedIn()
        && currentAccess().data.approved == true
        && (
          currentAccess().data.role == "ADMIN" ||
          currentAccess().data.role == "PARTNER" ||
          currentAccess().data.role == "VIEWER"
        );
    }

    function admin() {
      return signedIn()
        && currentAccess().data.approved == true
        && currentAccess().data.role == "ADMIN";
    }

    function member(businessId) {
      return signedIn()
        && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.approved == true
        && get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.blocked == false;
    }

    function businessAdmin(businessId) {
      return member(businessId)
        && get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.role == "OWNER";
    }

    match /accessUsers/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email_verified == true
        && (
          (request.resource.data.role == "PARTNER" &&
           request.resource.data.approved == false &&
           request.resource.data.email == request.auth.token.email)
          ||
          (request.resource.data.role == "ADMIN" &&
           request.resource.data.approved == true &&
           request.resource.data.email == request.auth.token.email &&
           (!exists(/databases/$(database)/documents/appConfig/admin) ||
            get(/databases/$(database)/documents/appConfig/admin).data.uid == request.auth.uid))
        );
      allow update, delete: if admin();
    }

    match /appConfig/admin {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && !exists(/databases/$(database)/documents/appConfig/admin)
        && request.resource.data.role == "ADMIN"
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if admin();
    }

    match /licenses/{licenseCode} {
      allow get: if true;
      allow list: if admin();
      allow create, update, delete: if admin();
    }

    match /businesses/{businessId} {
      allow read: if member(businessId) || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if businessAdmin(businessId);

      match /members/{memberId} {
        allow read: if member(businessId) && (request.auth.uid == memberId || businessAdmin(businessId));
        allow create: if businessAdmin(businessId) || (signedIn() && memberId == request.auth.uid && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid && request.resource.data.role == "OWNER");
        allow update, delete: if businessAdmin(businessId);
      }

      match /data/{document} {
        allow read: if member(businessId);
        allow write: if businessAdmin(businessId);
      }
    }

    // Legacy user-scoped data is retained temporarily for migration.
    match /users/{userId}/data/{document} {
      allow read: if approvedUser() && (request.auth.uid == userId || admin());
      allow write: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentAccess() {
      return get(/databases/$(database)/documents/accessUsers/$(request.auth.uid));
    }

    function admin() {
      return signedIn()
        && currentAccess().data.approved == true
        && currentAccess().data.blocked != true
        && currentAccess().data.role == "ADMIN";
    }

    function enterpriseAdmin() {
      return signedIn()
        && (
          (
            exists(/databases/$(database)/documents/appConfig/admin)
            && get(/databases/$(database)/documents/appConfig/admin).data.uid == request.auth.uid
            && get(/databases/$(database)/documents/appConfig/admin).data.role == "ADMIN"
          )
          ||
          (
            exists(/databases/$(database)/documents/accessUsers/$(request.auth.uid))
            && get(/databases/$(database)/documents/accessUsers/$(request.auth.uid)).data.uid == request.auth.uid
            && get(/databases/$(database)/documents/accessUsers/$(request.auth.uid)).data.role == "ADMIN"
            && get(/databases/$(database)/documents/accessUsers/$(request.auth.uid)).data.approved == true
            && get(/databases/$(database)/documents/accessUsers/$(request.auth.uid)).data.blocked != true
          )
        );
    }

    function isBusinessOwner(businessId) {
      return signedIn()
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
    }

    function hasViewAccess(businessId) {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/businesses/$(businessId)/viewAccess/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/businesses/$(businessId)/viewAccess/$(request.auth.token.email.lower())).data.email == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/businesses/$(businessId)/viewAccess/$(request.auth.token.email.lower())).data.businessId == businessId
        && get(/databases/$(database)/documents/businesses/$(businessId)/viewAccess/$(request.auth.token.email.lower())).data.active == true;
    }

    match /accessRequests/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if enterpriseAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "PENDING"
        && request.resource.data.startAt == 0
        && request.resource.data.expiresAt == 0
        && request.resource.data.notificationsEnabled == false;

      allow update: if enterpriseAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.status in ["PENDING", "ACTIVE", "BLOCKED", "REJECTED", "EXPIRED"]
        && request.resource.data.startAt is int
        && request.resource.data.expiresAt is int
        && request.resource.data.notificationsEnabled is bool;

      allow delete: if enterpriseAdmin();
    }

    match /accessUsers/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || admin());

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email_verified == true
        && request.resource.data.role == "ADMIN"
        && request.resource.data.approved == true
        && request.resource.data.email == request.auth.token.email
        && (
          !exists(/databases/$(database)/documents/appConfig/admin)
          || get(/databases/$(database)/documents/appConfig/admin).data.uid == request.auth.uid
        );

      allow update, delete: if admin();
    }

    match /appConfig/admin {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && !exists(/databases/$(database)/documents/appConfig/admin)
        && request.resource.data.role == "ADMIN"
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;

      allow update, delete: if admin();
    }

    match /businesses/{businessId} {
      allow read: if isBusinessOwner(businessId) || hasViewAccess(businessId);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isBusinessOwner(businessId);

      match /viewAccess/{emailKey} {
        allow read: if isBusinessOwner(businessId)
          || (
            signedIn()
            && request.auth.token.email_verified == true
            && request.auth.token.email != null
            && emailKey == request.auth.token.email.lower()
            && resource.data.email == request.auth.token.email.lower()
            && resource.data.active == true
          );

        allow create, update: if isBusinessOwner(businessId)
          && request.resource.data.email == emailKey
          && request.resource.data.email == request.resource.data.email.lower()
          && request.resource.data.businessId == businessId
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.active == true;

        allow delete: if isBusinessOwner(businessId);
      }

      match /members/{memberId} {
        allow read: if isBusinessOwner(businessId) || hasViewAccess(businessId);

        allow create, update: if signedIn()
          && memberId == request.auth.uid
          && isBusinessOwner(businessId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == "OWNER"
          && request.resource.data.approved == true
          && request.resource.data.blocked == false;

        allow delete: if signedIn()
          && memberId == request.auth.uid
          && isBusinessOwner(businessId);
      }

      match /data/{document} {
        allow read: if isBusinessOwner(businessId) || hasViewAccess(businessId);
        allow write: if isBusinessOwner(businessId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

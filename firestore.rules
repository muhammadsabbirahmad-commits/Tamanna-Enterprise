rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidShop(data, shopId) {
      return data.keys().hasAll([
          'ownerUid',
          'ownerEmail',
          'shopName',
          'updatedAt',
          'serverCreatedAt',
          'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'ownerEmail',
          'shopName',
          'updatedAt',
          'serverCreatedAt',
          'serverUpdatedAt'
        ])
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && data.ownerUid == shopId
        && data.ownerUid.size() >= 1
        && data.ownerUid.size() <= 128
        && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerEmail is string
        && data.ownerEmail.size() <= 254
        && data.shopName is string
        && data.shopName.size() >= 1
        && data.shopName.size() <= 120
        && (data.updatedAt is int || data.updatedAt is float)
        && data.updatedAt >= 0
        && data.serverCreatedAt is timestamp
        && data.serverUpdatedAt is timestamp;
    }

    function isValidCollectionKey(key) {
      return key in [
        'products',
        'inventory_meta',
        'stock_history',
        'sales',
        'sale_transactions',
        'sale_returns',
        'sale_return_lines',
        'sale_exchanges',
        'purchases',
        'suppliers',
        'supplier_dues',
        'customers',
        'customer_dues',
        'expenses',
        'damages',
        'partners',
        'partner_rates',
        'partner_capital',
        'partner_withdrawals',
        'partner_capitalized',
        'cash_accounts',
        'opening_balance',
        'daily_balances',
        'activity_logs',
        'settings'
      ];
    }

    function isValidRecord(data) {
      return data.keys().hasAll([
          'ownerUid',
          'businessId',
          'collectionKey',
          'itemId',
          'payload',
          'deleted',
          'updatedAt',
          'serverCreatedAt',
          'serverUpdatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'businessId',
          'collectionKey',
          'itemId',
          'payload',
          'deleted',
          'updatedAt',
          'serverCreatedAt',
          'serverUpdatedAt'
        ])
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        && data.ownerUid.size() >= 1
        && data.ownerUid.size() <= 128
        && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.businessId is string
        && data.businessId.size() >= 1
        && data.businessId.size() <= 64
        && data.businessId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.collectionKey is string
        && data.collectionKey.size() >= 1
        && data.collectionKey.size() <= 64
        && isValidCollectionKey(data.collectionKey)
        && data.itemId is string
        && data.itemId.size() >= 1
        && data.itemId.size() <= 128
        && data.payload is map
        && data.payload.keys().size() <= 40
        && data.deleted is bool
        && (data.updatedAt is int || data.updatedAt is float)
        && data.updatedAt >= 0
        && data.serverCreatedAt is timestamp
        && data.serverUpdatedAt is timestamp;
    }

    function isShopOwner(shopId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid;
    }

    match /shops/{shopId} {
      allow get: if isSignedIn() && isValidId(shopId) && existing().ownerUid == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerUid == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(shopId)
        && isValidShop(incoming(), shopId)
        && incoming().serverCreatedAt == request.time
        && incoming().serverUpdatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(shopId)
        && existing().ownerUid == request.auth.uid
        && isValidShop(incoming(), shopId)
        && incoming().ownerUid == existing().ownerUid
        && incoming().serverCreatedAt == existing().serverCreatedAt
        && incoming().serverUpdatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'ownerEmail',
          'shopName',
          'updatedAt',
          'serverUpdatedAt'
        ]);

      allow delete: if false;

      match /records/{recordId} {
        allow get: if isSignedIn()
          && isValidId(shopId)
          && isValidId(recordId)
          && existing().ownerUid == request.auth.uid
          && isShopOwner(shopId);

        allow list: if isSignedIn() && existing().ownerUid == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(shopId)
          && isValidId(recordId)
          && isValidRecord(incoming())
          && incoming().serverCreatedAt == request.time
          && incoming().serverUpdatedAt == request.time
          && isShopOwner(shopId);

        allow update: if isVerifiedUser()
          && isValidId(shopId)
          && isValidId(recordId)
          && existing().ownerUid == request.auth.uid
          && isValidRecord(incoming())
          && incoming().ownerUid == existing().ownerUid
          && incoming().businessId == existing().businessId
          && incoming().collectionKey == existing().collectionKey
          && incoming().itemId == existing().itemId
          && incoming().serverCreatedAt == existing().serverCreatedAt
          && incoming().serverUpdatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'payload',
            'deleted',
            'updatedAt',
            'serverUpdatedAt'
          ])
          && isShopOwner(shopId);

        allow delete: if isVerifiedUser()
          && isValidId(shopId)
          && isValidId(recordId)
          && existing().ownerUid == request.auth.uid
          && isShopOwner(shopId);
      }
    }
  }
}
